# React Query (TanStack Query) Patterns

## Setup

### QueryClientProvider
Wrap your app with `QueryClientProvider` in the root layout:

```tsx
// components/providers.tsx
"use client";

import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { useState } from "react";

export function Providers({ children }: { children: React.ReactNode }) {
  const [queryClient] = useState(
    () =>
      new QueryClient({
        defaultOptions: {
          queries: {
            staleTime: 5 * 60 * 1000, // 5 minutes
            refetchOnWindowFocus: false,
            retry: 1,
          },
        },
      })
  );

  return (
    <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>
  );
}
```

```tsx
// app/layout.tsx
import { Providers } from "@/components/providers";

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html>
      <body>
        <Providers>
          {children}
        </Providers>
      </body>
    </html>
  );
}
```

## Query Patterns

### Basic Query with Server Action
```tsx
import { useQuery } from "@tanstack/react-query";
import { getCurrentUserConfig } from "@/app/actions/user-config";

const {
  data: userConfig,
  isLoading,
  error,
} = useQuery({
  queryKey: ["userConfig"],
  queryFn: getCurrentUserConfig,
  enabled: !isPending && !!user, // Conditional fetching
});
```

### Query with Dependencies
```tsx
// Query depends on another query's data
const { data: userConfig } = useQuery({
  queryKey: ["userConfig"],
  queryFn: getCurrentUserConfig,
});

const inboundApiKey = userConfig?.inboundApiKey ?? "";

// Dependent query only runs when API key exists
const { data: domainsData } = useQuery({
  queryKey: ["domains", inboundApiKey],
  queryFn: () => fetchInboundDomains(inboundApiKey),
  enabled: !isPending && !!user && !!inboundApiKey,
  select: (result) => (result.success ? result.data : []), // Transform data
});
```

### Query with Data Transformation
```tsx
// Handle server actions that return { success, data, error }
const {
  data: channelsResult,
  isLoading: isLoadingChannels,
} = useQuery({
  queryKey: ["slackChannels"],
  queryFn: fetchSlackChannels,
  enabled: !isPending && !!user,
});

// Extract data and errors from result object
const slackChannels = channelsResult?.success 
  ? (channelsResult.data ?? []) 
  : [];
const channelsError = channelsResult?.success === false 
  ? channelsResult 
  : null;
```

### Query Key Patterns
```tsx
// Simple key
queryKey: ["userConfig"]

// Key with parameters
queryKey: ["domains", apiKey]
queryKey: ["workspace", teamId]
queryKey: ["channel", channelId]

// Array keys for organization
queryKey: ["slack", "channels", teamId]
queryKey: ["slack", "workspace", teamId]
```

## Mutation Patterns

### Basic Mutation with Invalidation
```tsx
import { useMutation, useQueryClient } from "@tanstack/react-query";

const queryClient = useQueryClient();

const updateConfigMutation = useMutation({
  mutationFn: updateUserConfig,
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ["userConfig"] });
  },
});

// Usage
const handleSave = async () => {
  const result = await updateConfigMutation.mutateAsync({
    shouldShowFullEmail: true,
  });
  
  if (!result.success) {
    setError(result.error || "Failed to save");
  }
};
```

### Mutation Invalidating Multiple Queries
```tsx
const updateApiKeyMutation = useMutation({
  mutationFn: updateInboundApiKey,
  onSuccess: (_, apiKey) => {
    queryClient.invalidateQueries({ queryKey: ["userConfig"] });
    queryClient.invalidateQueries({ queryKey: ["domains", apiKey] });
  },
});
```

### Mutation with Error Handling
```tsx
const [error, setError] = useState<string | null>(null);

const mutation = useMutation({
  mutationFn: updateUserConfig,
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ["userConfig"] });
    setError(null);
  },
  onError: (error) => {
    setError(error instanceof Error ? error.message : "Failed to update");
  },
});
```

## Loading and Error States

### Loading States
```tsx
// Component-level loading
if (isInitialLoading) {
  return <LoadingSpinner />;
}

// Inline loading state
{isLoadingChannels ? (
  <div className="flex items-center gap-3">
    <div className="h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent" />
    <span>Loading channels...</span>
  </div>
) : (
  <ChannelsList data={slackChannels} />
)}
```

### Error States
```tsx
// Handle errors from server actions that return { success, error }
const channelsErrorMessage = channelsError?.error === "bot_not_installed"
  ? "bot_not_installed"
  : channelsError?.error || channelsError?.message || null;

{channelsErrorMessage === "bot_not_installed" ? (
  <div className="rounded-md border border-orange-500/50 bg-orange-500/10 p-4">
    <p>Bot Not Installed</p>
    <Link href="/nextjs/api/slack/install">Install Bot Now</Link>
  </div>
) : channelsErrorMessage ? (
  <div className="rounded-md border border-destructive/50 bg-destructive/10 p-4">
    <p>{channelsErrorMessage}</p>
  </div>
) : null}
```

## Query Invalidation

### Invalidate Single Query
```tsx
queryClient.invalidateQueries({ queryKey: ["userConfig"] });
```

### Invalidate Queries with Prefix
```tsx
// Invalidates all queries starting with "slack"
queryClient.invalidateQueries({ 
  queryKey: ["slack"] 
});
```

### Invalidate with Parameters
```tsx
queryClient.invalidateQueries({ 
  queryKey: ["domains", apiKey] 
});
```

### Invalidate Multiple Related Queries
```tsx
const invalidateAll = () => {
  queryClient.invalidateQueries({ queryKey: ["userConfig"] });
  queryClient.invalidateQueries({ queryKey: ["domains"] });
  queryClient.invalidateQueries({ queryKey: ["slackChannels"] });
};
```

## Conditional Fetching

### Based on Auth State
```tsx
const { data: session, isPending } = useSession();

const { data } = useQuery({
  queryKey: ["userData"],
  queryFn: fetchUserData,
  enabled: !isPending && !!session?.user,
});
```

### Based on Dependencies
```tsx
const { data: config } = useQuery({
  queryKey: ["config"],
  queryFn: getConfig,
});

const apiKey = config?.apiKey ?? "";

const { data: domains } = useQuery({
  queryKey: ["domains", apiKey],
  queryFn: () => fetchDomains(apiKey),
  enabled: !!apiKey, // Only fetch when API key exists
});
```

### Based on Multiple Conditions
```tsx
const { data } = useQuery({
  queryKey: ["data"],
  queryFn: fetchData,
  enabled: !isPending && !!user && !!someOtherCondition,
});
```

## Data Transformation with Select

### Transform Response Data
```tsx
const { data: domains } = useQuery({
  queryKey: ["domains", apiKey],
  queryFn: () => fetchInboundDomains(apiKey),
  select: (result) => (result.success ? result.data : []),
});
```

### Extract Nested Data
```tsx
const { data: workspaceInfo } = useQuery({
  queryKey: ["workspaceInfo"],
  queryFn: getSlackWorkspaceInfo,
  select: (result) => result.success ? result.data : null,
});
```

## Best Practices

1. **Always use `enabled` for conditional fetching** - Don't fetch when dependencies aren't ready
2. **Use descriptive query keys** - Make them hierarchical: `["slack", "channels", teamId]`
3. **Transform data with `select`** - Keep component logic clean
4. **Invalidate related queries after mutations** - Keep cache in sync
5. **Handle server action results** - Most server actions return `{ success, data, error }`
6. **Extract data immediately** - Don't pass full result objects to components
7. **Use `isLoading` for initial load** - Use `isFetching` for background updates
8. **Set appropriate `staleTime`** - Balance freshness vs. performance
9. **Disable `refetchOnWindowFocus`** - Avoid unnecessary refetches
10. **Handle errors gracefully** - Provide user-friendly error messages
11. **Use `mutateAsync` when you need the result** - Use `mutate` for fire-and-forget
12. **Combine queries when needed** - Multiple queries can be composed together
13. **Keep query keys consistent** - Use the same key structure across the app

## Common Patterns

### Extracting Data from Server Action Results
```tsx
// Server action returns: { success: boolean, data?: T, error?: string }
const { data: result } = useQuery({
  queryKey: ["resource"],
  queryFn: fetchResource,
});

const resource = result?.success ? result.data : null;
const error = result?.success === false ? result.error : null;
```

### Using Query Client in Mutations
```tsx
const queryClient = useQueryClient();

const mutation = useMutation({
  mutationFn: updateResource,
  onSuccess: () => {
    queryClient.invalidateQueries({ queryKey: ["resource"] });
  },
});
```

### Accessing Query State
```tsx
const {
  data,
  isLoading,
  isFetching,
  isError,
  error,
  refetch,
} = useQuery({
  queryKey: ["data"],
  queryFn: fetchData,
});

// isLoading: true during initial load
// isFetching: true during any fetch (including background refetch)
// isError: true if query failed
// refetch: function to manually refetch
```

### Disabling Mutations During Loading
```tsx
<Button
  onClick={() => mutation.mutate(data)}
  disabled={mutation.isPending || isLoading}
>
  {mutation.isPending ? "Saving..." : "Save"}
</Button>
```

## Anti-Patterns to Avoid

1. ❌ **Don't fetch without `enabled` checks** - This causes unnecessary requests
2. ❌ **Don't forget to invalidate queries** - Cache will be stale after mutations
3. ❌ **Don't pass full result objects to components** - Extract data immediately
4. ❌ **Don't use `useState` + `useEffect` for fetching** - Use React Query instead
5. ❌ **Don't manually manage loading states** - Use `isLoading` from React Query
6. ❌ **Don't refetch on window focus unnecessarily** - Disable it in defaults
7. ❌ **Don't create queries without proper query keys** - Keys are crucial for caching
