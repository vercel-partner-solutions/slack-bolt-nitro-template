# Slack App Configuration
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_STATE_SECRET=your-state-secret-for-oauth

# Optional: Fallback bot token for development (single workspace mode)
# This allows event subscription URL verification to work before OAuth installations are set up
# Remove or comment out in production to use multi-workspace OAuth mode
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# Inbound.new Email Integration
INBOUND_API_KEY=your-inbound-api-key

# Optional: Override default channel for email notifications
# Default: C085A8KPY66 (#slackbound-testing)
# INBOUND_SLACK_CHANNEL_ID=C085A8KPY66

# Optional: ngrok auth token for local development with tunnel
# NGROK_AUTH_TOKEN=your-ngrok-token

# Redis Configuration (Upstash) - Required for persistent thread storage
# Get these from: https://console.upstash.com/
# Without Redis, thread mappings will be lost on server restart
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Database Configuration (NeonDB)
# Get your connection string from: https://console.neon.tech/
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Encryption Key for Bot Tokens
# Generate a strong random key: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# Internal API Key for Dashboard <> API Server Communication
# Generate: openssl rand -base64 32
INTERNAL_API_KEY=your-internal-api-key-here

