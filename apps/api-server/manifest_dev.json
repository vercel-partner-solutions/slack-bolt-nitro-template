{
  "display_information": {
      "name": "slackbound - dev",
      "background_color": "#0f0014"
  },
  "features": {
      "app_home": {
          "home_tab_enabled": true,
          "messages_tab_enabled": false,
          "messages_tab_read_only_enabled": true
      },
      "bot_user": {
          "display_name": "slackbound - dev",
          "always_online": true
      },
      "shortcuts": [
          {
              "name": "Forward to Email",
              "type": "message",
              "callback_id": "forward_message_to_email",
              "description": "Forward this Slack message as an email"
          },
          {
              "name": "Compose Email",
              "type": "global",
              "callback_id": "compose_email_shortcut",
              "description": "Quickly compose and send a new email"
          }
      ],
      "slash_commands": [
          {
              "command": "/compose",
              "url": "https://dev.slackbound.com/api/slack/events",
              "description": "Composes a new email",
              "should_escape": false
          }
      ]
  },
  "oauth_config": {
      "redirect_urls": [
          "https://dev.slackbound.com/nextjs/api/slack/callback",
          "https://dev.slackbound.com/api/auth/callback/slack"
      ],
      "scopes": {
          "user": [
              "team:read"
          ],
          "bot": [
              "channels:history",
              "channels:manage",
              "channels:read",
              "chat:write",
              "chat:write.customize",
              "chat:write.public",
              "commands",
              "files:write",
              "groups:history",
              "groups:read",
              "groups:write",
              "im:history",
              "im:read",
              "im:write",
              "mpim:history",
              "mpim:read",
              "reactions:read",
              "reactions:write",
              "users:read"
          ]
      }
  },
  "settings": {
      "event_subscriptions": {
          "request_url": "https://dev.slackbound.com/api/slack/events",
          "bot_events": [
              "app_home_opened",
              "app_uninstalled",
              "message.channels",
              "message.groups",
              "message.im",
              "message.mpim"
          ]
      },
      "interactivity": {
          "is_enabled": true,
          "request_url": "https://dev.slackbound.com/api/slack/events"
      },
      "org_deploy_enabled": true,
      "socket_mode_enabled": false,
      "token_rotation_enabled": false
  }
}